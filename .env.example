# 이 파일을 .env.local 로 복사해서 쓴다. .env.local 은 커밋하지 않는다.
# 여기에는 변수 이름과 공개해도 되는 기본값만 적는다. 비밀 값은 적지 않는다.

# --- 화면 (개발자 B) ---
# 0 이면 실제 API(/api/...)를 부른다. 그 밖에는 예시 데이터를 쓴다.
NEXT_PUBLIC_USE_FIXTURES=1

# 배경 지도 스타일 주소. 비워 두면 공개 스타일을 쓴다.
NEXT_PUBLIC_BASEMAP_STYLE_URL=

# 지형 타일(terrain-RGB, {z}/{x}/{y}). 비워 두면 공개 지형 타일을 쓴다.
NEXT_PUBLIC_TERRAIN_TILES_URL=

# 위험 구역 PMTiles 주소. 비워 두면 임시 구역 도형을 쓴다.
NEXT_PUBLIC_ZONES_PMTILES_URL=

# 지형 위에 입히는 항공·위성 사진 타일 주소({z}/{x}/{y} 또는 {z}/{y}/{x}).
# 비워 두면 미국 USGS 항공 사진을 쓴다(미국 지역만 나온다).
NEXT_PUBLIC_SATELLITE_TILES_URL=

# 과거 침수 흔적 타일 주소. 비워 두면 해당 레이어를 켤 수 없다.
NEXT_PUBLIC_FLOOD_TILES_URL=
